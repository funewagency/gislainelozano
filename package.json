{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bunx next dev -p 3000",
    "build": "next build && node -e \"const fs=require('fs'); fs.cpSync('.next/static', '.next/standalone/.next/static', {recursive:true}); fs.cpSync('public', '.next/standalone/public', {recursive:true});\"",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:video": "npm run build && playwright test --reporter=list,html",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "test:e2e:watch": "npm run build && playwright test --reporter=list,html --trace=on --video=on",
    "test:e2e:report": "playwright show-report test-report",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "bun prisma/seed.ts"
  },
