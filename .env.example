# ==============================================================================
# EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# NUNCA insira senhas, chaves privadas ou credenciais reais de produção neste arquivo.
# ==============================================================================

# --- Banco de Dados (PostgreSQL / Supabase) ---
# DATABASE_URL: Conexão via pooler (porta 6543) com pgbouncer para Next.js / Vercel
DATABASE_URL="postgresql://postgres.[PROJETO]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: Conexão direta (porta 5432) para Prisma Migrations e Seed
DIRECT_URL="postgresql://postgres.[PROJETO]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
DATABASE_PROVIDER="postgresql"

# --- Autenticação do Painel Administrativo (/admin) ---
ADMIN_USERNAME="admin"
# Gere o hash SHA-256 da sua senha com o comando: echo -n "sua-senha" | sha256sum
ADMIN_PASSWORD_HASH="hash_sha256_da_sua_senha_aqui"
# Gere um segredo forte com o comando: openssl rand -base64 32
NEXTAUTH_SECRET="segredo_aleatorio_nextauth_com_no_minimo_32_caracteres"
NEXTAUTH_URL="http://localhost:3000"

# --- CMS Remoto (Opcional) ---
NEXT_PUBLIC_CMS_URL=""
NEXT_PUBLIC_TENANT_SLUG="gislaine"
WEBHOOK_SECRET="segredo_para_assinatura_do_webhook_de_revalidacao"

# --- Analytics e Rastreamento (Opcional) ---
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_POSTHOG_PROJECT_ID=""
NEXT_PUBLIC_POSTHOG_API_KEY=""

# --- Limites de Taxa (Opcional) ---
RATE_LIMIT_CONTACT_MAX="5"
